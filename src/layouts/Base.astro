---
import '../styles/global.css';
// Fonts the first screen needs (headline + body): preloaded so the hero text doesn't re-render late.
// The URLs resolve to the same hashed files the @font-face rules point to.
import unbounded from '../assets/fonts/unbounded-ro-wght.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { site } from '../config/site';
import { defaultLang, homePath, languages, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
  /** Schema.org JSON-LD object, rendered as a script tag. */
  jsonLd?: object;
}

const { lang, title, description, noindex = false, jsonLd } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(homePath(lang), Astro.site);
const codes = Object.keys(languages) as Lang[];
const ogImage = new URL(`/og-${lang}.png`, Astro.site);
const locales: Record<Lang, string> = { ro: 'ro_RO', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Scroll-reveal hides elements only when JS runs, so no-JS visitors and crawlers always see everything. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {[unbounded, manropeLatin].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {codes.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(homePath(code), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLang), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    {codes.filter((c) => c !== lang).map((c) => <meta property="og:locale:alternate" content={locales[c]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    <script>
      // One observer for every [data-reveal] / [data-stagger]: adds .is-in once, the first time it scrolls into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal], [data-stagger]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
