---
import '../styles/global.css';
import { site } from '../config/site';
import { defaultLang, homePath, languages, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(homePath(lang), Astro.site);
const codes = Object.keys(languages) as Lang[];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {codes.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(homePath(code), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLang), Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
