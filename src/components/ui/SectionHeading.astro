---
// Section intro as "HOW DOES IT WORK?" in the reference: big heading on the left,
// a short bold uppercase line and a paragraph on the right.
interface Props {
  title: string;
  kicker?: string;
  intro?: string;
  id?: string;
  class?: string;
}

const { title, kicker, intro, id, class: className } = Astro.props;
---

<div class:list={['grid gap-6 md:grid-cols-2 md:items-start md:gap-10', className]}>
  <h2 id={id} class="text-[2rem] leading-[1.02] sm:text-5xl lg:text-6xl">{title}</h2>
  {(kicker || intro) && (
    <div class="max-w-md md:justify-self-end md:pt-2">
      {kicker && <p class="text-[13px] font-bold uppercase tracking-wide">{kicker}</p>}
      {intro && <p class="mt-3 text-[15px] text-graphite">{intro}</p>}
    </div>
  )}
</div>
