---
// Section intro as "HOW DOES IT WORK?" in the reference: big heading on the left,
// a short bold uppercase line and a paragraph on the right.
interface Props {
  title: string;
  kicker?: string;
  intro?: string;
  id?: string;
  class?: string;
}

const { title, kicker, intro, id, class: className } = Astro.props;
---

<div data-reveal class:list={['grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start lg:gap-10', className]}>
  <h2 id={id} class="text-[clamp(1.5rem,8.6vw,2rem)] leading-[1.02] sm:text-5xl lg:text-[clamp(2.75rem,4.2vw,3.75rem)]">{title}</h2>
  {(kicker || intro) && (
    <div class="max-w-md lg:justify-self-end lg:pt-2">
      {kicker && <p class="text-[13px] font-bold uppercase tracking-wide">{kicker}</p>}
      {intro && <p class="mt-3 text-[15px] text-graphite">{intro}</p>}
    </div>
  )}
</div>
