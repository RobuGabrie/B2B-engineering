---
// Card from the reference: rounded corners, top-right corner cut at 45° (with softened joints),
// thin gray outline and four orange ticks just outside the corners.
// The outline is an SVG drawn as a 9-slice border-image, so the corners never stretch at any card size.
interface Props {
  ticks?: boolean;
  /** Orange outline instead of gray (e.g. the result step). */
  accent?: boolean;
  /** Dark fill with light text, to break up a row of cards. */
  dark?: boolean;
  /** Inner padding classes. */
  pad?: string;
  as?: 'div' | 'li' | 'article';
  class?: string;
}

const { ticks = true, accent = false, dark = false, pad = 'px-7 py-8 md:px-9 md:py-10', as: Tag = 'div', class: className } = Astro.props;

// Geometry, in px: corner radius, chamfer length along each edge, joint softening, slice size.
const R = 28;
const C = 64;
const J = 8;
const S = 80;
const W = 200;
const H = 200;
const d = J / Math.SQRT2;
const e = 0.5; // half the stroke width, keeps the 1px line crisp inside the box

const path = [
  `M ${R} ${e}`,
  `H ${W - C - J}`,
  `Q ${W - C} ${e} ${W - C + d} ${e + d}`,
  `L ${W - e - d} ${C - d}`,
  `Q ${W - e} ${C} ${W - e} ${C + J}`,
  `V ${H - R}`,
  `A ${R - e} ${R - e} 0 0 1 ${W - R} ${H - e}`,
  `H ${R}`,
  `A ${R - e} ${R - e} 0 0 1 ${e} ${H - R}`,
  `V ${R}`,
  `A ${R - e} ${R - e} 0 0 1 ${R} ${e}`,
  'Z',
].join(' ');

const outline = (stroke: string, fill = '#fff') =>
  `url("data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' viewBox='0 0 ${W} ${H}'><path d='${path}' fill='${fill}' stroke='${stroke}' stroke-width='1'/></svg>`,
  ).replace(/%2523/g, '%23')}")`;
---

<Tag
  class:list={['chamfer-card relative', dark && 'text-paper', className]}
  style={dark
    ? `--outline: ${outline('#0d0d0e', '#0d0d0e')}; --outline-hover: ${outline('#0d0d0e', '#0d0d0e')}; --slice: ${S};`
    : `--outline: ${outline(accent ? '#ff5b14' : '#e2e2de')}; --outline-hover: ${outline(accent ? '#ff5b14' : '#8a8a86')}; --slice: ${S};`}
>
  {ticks && (
    <>
      <span aria-hidden="true" class="tick -top-3 -left-3" />
      <span aria-hidden="true" class="tick -top-3 -right-3" />
      <span aria-hidden="true" class="tick -bottom-3 -left-3" />
      <span aria-hidden="true" class="tick -right-3 -bottom-3" />
    </>
  )}
  <div class:list={['relative h-full', pad]}>
    <slot />
  </div>
</Tag>

<style>
  .chamfer-card {
    border: 1px solid transparent;
    border-image-source: var(--outline);
    border-image-slice: var(--slice) fill;
    border-image-width: calc(var(--slice) * 1px);
    min-height: calc(var(--slice) * 2px);
  }
  .chamfer-card:hover {
    border-image-source: var(--outline-hover);
  }
  .tick {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    pointer-events: none;
  }
</style>
