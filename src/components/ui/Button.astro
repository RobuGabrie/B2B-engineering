---
// Primary = safety-orange fill with ink text (AA contrast); outline = thin ink border, as in the nav of the reference.
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'outline' | 'link';
  size?: 'md' | 'lg';
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-3 font-display font-semibold uppercase tracking-wide transition-colors duration-150 select-none';

const variants = {
  primary: 'bg-accent text-ink hover:bg-ink hover:text-paper',
  outline: 'border border-ink/80 text-ink hover:border-accent hover:text-accent-ink',
  link: 'text-ink underline decoration-accent decoration-2 underline-offset-8 hover:text-accent-ink',
};

const sizes = {
  md: 'min-h-11 px-5 text-xs',
  lg: 'min-h-14 px-7 text-sm',
};

const classes = [base, variants[variant], variant !== 'link' && sizes[size], className];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={classes} {...rest}>
  <slot />
</Tag>
