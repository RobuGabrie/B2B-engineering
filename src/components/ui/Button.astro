---
// As in the reference: plain sans uppercase labels, 3px corners. Primary = orange fill (ink text for AA contrast);
// outline = thin orange border on white ("BOOK A DEMO" in the reference nav).
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'outline' | 'link';
  size?: 'md' | 'lg';
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-3 rounded-[3px] font-sans font-semibold uppercase tracking-wide transition-colors duration-150 select-none';

const variants = {
  primary: 'bg-accent text-ink hover:bg-ink hover:text-paper',
  outline: 'border border-accent bg-paper text-ink hover:bg-accent',
  link: 'rounded-none text-ink underline decoration-accent decoration-1 underline-offset-8 hover:text-accent-ink',
};

const sizes = {
  md: 'min-h-11 px-5 text-[13px]',
  lg: 'min-h-14 px-7 text-sm',
};

const classes = [base, variants[variant], variant !== 'link' && sizes[size], className];
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={classes} {...rest}>
  <slot />
</Tag>
