---
// Four small orange squares at the corners of the wrapped content, like crop marks on a technical drawing.
interface Props {
  /** Distance of the ticks outside the content box, in px. */
  offset?: number;
  size?: number;
  /** On load, the ticks slide out from the content to the corners. */
  animate?: boolean;
  class?: string;
}

const { offset = 12, size = 5, animate = false, class: className } = Astro.props;
const positions = [
  'top-(--tick-o) left-(--tick-o)',
  'top-(--tick-o) right-(--tick-o)',
  'bottom-(--tick-o) left-(--tick-o)',
  'bottom-(--tick-o) right-(--tick-o)',
];
---

<div
  class:list={['relative', animate && 'ticks-in', className]}
  style={`--tick-o: ${-offset}px; --tick-s: ${size}px;`}
>
  {positions.map((pos) => (
    <span aria-hidden="true" class:list={['tick pointer-events-none absolute size-(--tick-s) bg-accent', pos]} />
  ))}
  <slot />
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ticks-in .tick {
      animation: tick-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
    }
    .ticks-in .tick:nth-of-type(1) { --dx: 24px; --dy: 18px; }
    .ticks-in .tick:nth-of-type(2) { --dx: -24px; --dy: 18px; }
    .ticks-in .tick:nth-of-type(3) { --dx: 24px; --dy: -18px; }
    .ticks-in .tick:nth-of-type(4) { --dx: -24px; --dy: -18px; }
  }
  @keyframes tick-in {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy));
    }
  }
</style>
