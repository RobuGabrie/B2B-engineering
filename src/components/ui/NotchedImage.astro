---
// Photo cut into a non-rectangular shape, as in the reference:
// - md+: the notch content (slot) bites into the top-left corner; the step between them is slanted
//   and every joint is rounded. The notch size follows the content, measured live.
// - mobile: content sits above; the photo keeps the top-right 45° cut of the cards.
// `bleed`: photo runs edge to edge with square outer corners (hero); otherwise outer corners are rounded.
// The outline is applied as a clip-path computed from the real size (src/lib/shape.ts).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  bleed?: boolean;
  /** Horizontal run of the slanted step, px. */
  slant?: number;
  /** Rendered as the LCP image — loads eagerly with high priority. */
  priority?: boolean;
  class?: string;
  imgClass?: string;
}

const {
  src,
  alt,
  bleed = false,
  slant = 32,
  priority = false,
  class: className,
  imgClass = 'md:h-[34rem]',
} = Astro.props;
const hasNotch = Astro.slots.has('default');
---

<div
  class:list={['notched relative', bleed && 'is-bleed', className]}
  data-notched
  data-bleed={bleed ? '' : undefined}
  data-slant={slant}
>
  {hasNotch && (
    <div class="notch relative z-10 bg-paper pb-6 md:absolute md:top-0 md:left-0 md:pr-10 md:pb-8" data-notch>
      <slot />
    </div>
  )}
  <div class:list={['shape relative overflow-hidden', bleed ? 'rounded-none' : 'rounded-[28px]']} data-shape>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes={bleed ? '100vw' : '(min-width: 1200px) 1200px, 100vw'}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class:list={['aspect-4/3 w-full object-cover md:aspect-auto', imgClass]}
    />
    <slot name="overlay" />
  </div>
</div>

<style>
  /* Bleed: the notch content lines up with the page container while the photo spans the full width. */
  .is-bleed .notch {
    padding-left: max(1.25rem, calc((100vw - 75rem) / 2 + 1.25rem));
    padding-right: 1.25rem;
  }

  @media (min-width: 48rem) {
    .notch {
      max-width: min(42rem, 62%);
    }
    .is-bleed .notch {
      max-width: none;
      width: max(50%, calc((100vw - 75rem) / 2 + 38rem));
      padding-left: max(2.5rem, calc((100vw - 75rem) / 2 + 2.5rem));
      padding-right: 2.5rem;
    }
    /* Once the clip-path is applied the photo itself leaves the notch empty. */
    .notched.is-shaped .notch {
      background: transparent;
    }
  }

  .notched.is-shaped .shape {
    border-radius: 0;
  }
</style>

<script>
  import { notchPath, roundedPolygon } from '../../lib/shape';

  const desktop = window.matchMedia('(min-width: 48rem)');

  function apply(root: HTMLElement) {
    const shape = root.querySelector<HTMLElement>('[data-shape]')!;
    const notch = root.querySelector<HTMLElement>('[data-notch]');
    const bleed = root.hasAttribute('data-bleed');
    const slant = Number(root.dataset.slant ?? 32);
    const { width: W, height: H } = shape.getBoundingClientRect();
    const r = bleed ? 0 : 28;

    let d: string;
    if (desktop.matches && notch) {
      d = notchPath({
        width: W,
        height: H,
        notchW: notch.offsetWidth,
        notchH: notch.offsetHeight,
        slant,
        radius: r,
        joint: 28,
      });
    } else {
      // Mobile: the card language — rounded corners, top-right cut at 45°.
      const c = Math.min(56, W / 4);
      d = roundedPolygon(
        [[0, 0], [W - c, 0], [W, c], [W, H], [0, H]],
        [r || 0, 10, 10, r, r],
      );
    }

    shape.style.clipPath = `path('${d}')`;
    root.classList.add('is-shaped');
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-notched]')) {
    const ro = new ResizeObserver(() => apply(root));
    ro.observe(root);
    const notch = root.querySelector('[data-notch]');
    if (notch) ro.observe(notch);
    desktop.addEventListener('change', () => apply(root));
  }
</script>
