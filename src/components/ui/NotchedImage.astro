---
// Photo with a white notch cut into its top-left corner; the notch holds content (e.g. the hero buttons).
// The rounded inverse corners are drawn with radial gradients, so this assumes a paper-colored page behind it.
// `bleed`: the photo runs edge to edge (hero in the reference); otherwise it is a rounded block (video in the reference).
// On small screens the notch content sits above the photo instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  bleed?: boolean;
  /** Rendered as the LCP image — loads eagerly with high priority. */
  priority?: boolean;
  class?: string;
}

const { src, alt, bleed = false, priority = false, class: className } = Astro.props;
const hasNotch = Astro.slots.has('default');
---

<div class:list={['notched', bleed && 'is-bleed', className]}>
  {hasNotch && (
    <div class="notch relative z-10 bg-paper pb-6 md:absolute md:top-0 md:left-0 md:rounded-br-(--r) md:pr-8 md:pb-8">
      <slot />
    </div>
  )}
  <div class:list={['relative overflow-hidden', !bleed && 'rounded-(--r) md:rounded-tl-none']}>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes={bleed ? '100vw' : '(min-width: 1200px) 1200px, 100vw'}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="aspect-4/3 h-full w-full object-cover md:aspect-auto md:min-h-[34rem]"
    />
  </div>
</div>

<style>
  .notched {
    --r: 28px;
    position: relative;
  }

  /* Bleed: the notch content lines up with the page container while the photo spans the full width. */
  .is-bleed .notch {
    padding-left: max(1.25rem, calc((100vw - 75rem) / 2 + 1.25rem));
    padding-right: 1.25rem;
  }

  @media (min-width: 48rem) {
    .notch {
      max-width: min(42rem, 62%);
    }
    .is-bleed .notch {
      max-width: none;
      width: max(52%, calc((100vw - 75rem) / 2 + 40rem));
      padding-left: max(2.5rem, calc((100vw - 75rem) / 2 + 2.5rem));
      padding-right: 2.5rem;
    }

    /* Inverse rounded corners where the notch meets the photo: right of the notch and below it. */
    .notch::before,
    .notch::after {
      content: '';
      position: absolute;
      width: var(--r);
      height: var(--r);
      background: radial-gradient(circle at 100% 100%, transparent var(--r), var(--color-paper) calc(var(--r) + 0.5px));
    }
    .notch::before {
      top: 0;
      left: 100%;
    }
    .notch::after {
      top: 100%;
      left: 0;
    }
    /* With bleed the photo touches the page edge, so there's no corner below the notch to round. */
    .is-bleed .notch::after {
      display: none;
    }
  }
</style>
