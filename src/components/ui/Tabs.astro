---
// Accessible tabs with an orange underline. Panels come from named slots: `panel-<id>`.
// With JS, one underline slides between tabs instead of each tab drawing its own.
// Without JS every panel stays visible, so content is never hidden from crawlers or no-JS visitors.
interface Props {
  id: string;
  label: string;
  tabs: readonly { id: string; label: string }[];
  class?: string;
  panelClass?: string;
  /** On phones, tabs share the full width equally. */
  stretch?: boolean;
}

const { id, label, tabs, class: className, panelClass = 'pt-8', stretch = false } = Astro.props;
const panels = await Promise.all(tabs.map((tab) => Astro.slots.render(`panel-${tab.id}`)));
---

<div class:list={['tabs', className]} data-tabs>
  <div
    role="tablist"
    aria-label={label}
    class:list={['relative flex max-w-full overflow-x-auto [scrollbar-width:none] md:w-fit', stretch && 'max-md:[&>button]:flex-1']}
  >
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${tab.id}`}
        aria-controls={`${id}-panel-${tab.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="relative shrink-0 border-b border-line px-1 pt-3 pb-2.5 pr-5 last:pr-1 aria-selected:border-b-2 aria-selected:pb-[9px] font-sans text-[13px] font-bold uppercase tracking-wide whitespace-nowrap text-steel transition-colors focus-visible:-outline-offset-2 hover:text-ink aria-selected:border-accent aria-selected:text-ink"
      >
        {tab.label}
      </button>
    ))}
    <span class="ink" aria-hidden="true" data-ink></span>
  </div>

  {tabs.map((tab, i) => (
    <div
      role="tabpanel"
      id={`${id}-panel-${tab.id}`}
      aria-labelledby={`${id}-tab-${tab.id}`}
      tabindex="0"
      class:list={[panelClass, 'focus-visible:outline-offset-4']}
      data-initial-hidden={i === 0 ? undefined : ''}
      set:html={panels[i]}
    />
  ))}
</div>

<style>
  .ink {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--color-accent);
  }
  /* Transitions only after the first placement, so the underline doesn't grow in on page load. */
  .ink-ready .ink {
    transition:
      transform 0.35s cubic-bezier(0.3, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .has-ink [role='tab'][aria-selected='true'] {
    border-bottom-width: 1px;
    border-color: var(--color-line);
    padding-bottom: 10px;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    panels.forEach((p) => (p.hidden = p.hasAttribute('data-initial-hidden')));

    const ink = root.querySelector<HTMLElement>('[data-ink]')!;
    let current = 0;
    const moveInk = () => {
      const tab = tabs[current];
      ink.style.width = `${tab.offsetWidth}px`;
      ink.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    root.classList.add('has-ink');
    moveInk();
    requestAnimationFrame(() => root.classList.add('ink-ready'));
    new ResizeObserver(moveInk).observe(ink.parentElement!);

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      current = index;
      moveInk();
      if (focus) tabs[index].focus();
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
</script>
