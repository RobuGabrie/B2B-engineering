---
// SYNAPSE·TECH logo as inline SVG (src/assets/brand/logo.svg, rebuilt by scripts/build-logo.py).
// "YNAPSE" follows the text color; the S trace and "TECH" use the brand orange and cyan.
// `onDark`: the original bright cyan; on light backgrounds a deeper cyan keeps "TECH" readable.
// `animate`: on load the S is drawn like a signal along a trace: top node, orange half, cyan half, bottom node.
import logo from '../../assets/brand/logo.svg?raw';
import { site } from '../../config/site';

interface Props {
  onDark?: boolean;
  animate?: boolean;
  class?: string;
}

const { onDark = false, animate = false, class: className } = Astro.props;
const svg = logo.replace('role="img"', `role="img" aria-label="${site.name}"`);
---

<span class:list={['logo block [&>svg]:block [&>svg]:h-full [&>svg]:w-auto', onDark ? 'on-dark' : 'on-light', animate && 'animate', className]} set:html={svg} />

<style>
  .logo {
    --logo-a: var(--color-accent);
  }
  .on-light {
    --logo-b: var(--color-brand-cyan-ink);
  }
  .on-dark {
    --logo-b: var(--color-brand-cyan);
  }

  @media (prefers-reduced-motion: no-preference) {
    .animate :global(.s-a),
    .animate :global(.s-b) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: logo-draw 0.45s cubic-bezier(0.6, 0, 0.3, 1) 0.35s forwards;
    }
    .animate :global(.s-b) {
      animation-duration: 0.75s;
      animation-delay: 0.78s;
      animation-timing-function: cubic-bezier(0.3, 0, 0.3, 1);
    }
    .animate :global(.n-a),
    .animate :global(.n-b) {
      transform-box: fill-box;
      transform-origin: center;
      transform: scale(0);
      animation: logo-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 0.1s forwards;
    }
    .animate :global(.n-b) {
      animation-delay: 1.5s;
    }
  }

  @keyframes logo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes logo-pop {
    to {
      transform: scale(1);
    }
  }
</style>
