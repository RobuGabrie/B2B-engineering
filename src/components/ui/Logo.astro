---
// SYNAPSE·TECH logo as inline SVG (src/assets/brand/logo.svg, rebuilt by scripts/build-logo.py).
// "YNAPSE" follows the text color; the S trace and "TECH" use the brand orange and cyan.
// `onDark`: the original bright cyan; on light backgrounds a deeper cyan keeps "TECH" readable.
import logo from '../../assets/brand/logo.svg?raw';
import { site } from '../../config/site';

interface Props {
  onDark?: boolean;
  class?: string;
}

const { onDark = false, class: className } = Astro.props;
const svg = logo.replace('role="img"', `role="img" aria-label="${site.name}"`);
---

<span class:list={['logo block [&>svg]:block [&>svg]:h-full [&>svg]:w-auto', onDark ? 'on-dark' : 'on-light', className]} set:html={svg} />

<style>
  .logo {
    --logo-a: var(--color-accent);
  }
  .on-light {
    --logo-b: var(--color-brand-cyan-ink);
  }
  .on-dark {
    --logo-b: var(--color-brand-cyan);
  }
</style>
