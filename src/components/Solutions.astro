---
// "Ce rezolvăm concret": the four verticals as tabs. Photos alternate side and notch corner per vertical. Each panel: notched photo + problem / solution / benefit,
// a benefit box with concrete outcomes and the CTA; below, the full-width system diagram.
import SectionHeading from './ui/SectionHeading.astro';
import Tabs from './ui/Tabs.astro';
import NotchedImage from './ui/NotchedImage.astro';
import Button from './ui/Button.astro';
import SystemDiagram from './SystemDiagram.astro';
import { sectionHref, useTranslations, type Lang } from '../i18n/utils';
import iot from '../assets/images/iot-lathe.jpg';
import vision from '../assets/images/vision-cameras.jpg';
import rnd from '../assets/images/rnd-pcb-hand.jpg';
import automation from '../assets/images/logistics-shelves.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { labels } = t.solutions;
const images = { iot, vision, rnd, automation } as const;
const tabs = t.solutions.items.map(({ id, tab }) => ({ id, label: tab }));
---

<section id={t.anchors.solutions} class="container-site py-20 md:py-32" aria-labelledby="solutions-title">
  <SectionHeading id="solutions-title" title={t.solutions.title} kicker={t.solutions.kicker} intro={t.solutions.intro} />

  <Tabs id="solutions" label={t.solutions.title} tabs={tabs} class="mt-12 md:mt-16" panelClass="pt-8 md:pt-10">
    {t.solutions.items.map((item, i) => (
      <article slot={`panel-${item.id}`}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <NotchedImage
            src={images[item.id as keyof typeof images]}
            alt={item.imageAlt}
            corner={i % 2 ? 'br' : 'tl'}
            class:list={['lg:col-span-7 lg:self-start', i % 2 && 'lg:order-last']}
            imgClass="md:h-[30rem] lg:h-[38rem]"
          >
            <p class="flex items-center gap-4 pt-1 text-[13px] font-semibold uppercase">
              <span class="size-1.5 bg-accent" aria-hidden="true"></span>
              <span class="font-mono text-accent-ink">0{i + 1}</span>
              {item.tab}
            </p>
          </NotchedImage>

          <div class="flex flex-col lg:col-span-5">
            <h3 class="text-xl leading-tight md:text-2xl">{item.title}</h3>

            <dl class="mt-8 space-y-6">
              <div>
                <dt class="text-[13px] font-bold uppercase tracking-wide">{labels.problem}</dt>
                <dd class="mt-2 text-[15px] text-graphite">{item.problem}</dd>
              </div>
              <div>
                <dt class="text-[13px] font-bold uppercase tracking-wide">{labels.solution}</dt>
                <dd class="mt-2 text-[15px] text-graphite">{item.solution}</dd>
              </div>
            </dl>

            <div class="mt-8 rounded-[20px] bg-mist p-6 md:p-7">
              <p class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-wide">
                <span class="size-1.5 bg-accent" aria-hidden="true"></span>{labels.benefit}
              </p>
              <p class="mt-3 text-[17px] font-semibold leading-snug">{item.benefit}</p>
              <p class="mt-6 border-t border-line pt-5 font-mono text-[11px] uppercase tracking-wider text-steel">{labels.outcomes}</p>
              <ul class="mt-3 grid gap-2.5 sm:grid-cols-3 sm:gap-3 lg:grid-cols-1 lg:gap-2.5">
                {item.outcomes.map((o) => (
                  <li class="flex items-start gap-2.5 text-sm font-semibold leading-snug">
                    <svg viewBox="0 0 16 16" class="mt-px size-4 shrink-0" aria-hidden="true">
                      <rect width="16" height="16" rx="3" class="fill-accent" />
                      <path d="M4.5 8.2l2.3 2.3 4.7-4.9" fill="none" stroke="#0d0d0e" stroke-width="1.8" />
                    </svg>
                    {o}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6">
              <Button href={sectionHref(lang, 'contact')} class="w-full sm:w-auto">{t.solutions.cta}</Button>
            </div>
          </div>
        </div>

        <SystemDiagram
          class="mt-14 md:mt-16"
          title={labels.diagram}
          labels={[labels.input, labels.processing, labels.result]}
          stages={item.stages}
        />
      </article>
    ))}
  </Tabs>
</section>
