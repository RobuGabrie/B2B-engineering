---
// "Ce rezolvăm concret": the four verticals as tabs. Photos alternate side and notch corner per vertical. Each panel: notched photo,
// problem / solution / key benefit, the outcomes as a numbered hairline list, and an underlined CTA link (no boxes).
import SectionHeading from './ui/SectionHeading.astro';
import Tabs from './ui/Tabs.astro';
import NotchedImage from './ui/NotchedImage.astro';
import Button from './ui/Button.astro';
import LiveDot from './ui/LiveDot.astro';
import { pages, sectionHref, useTranslations, type Lang, type ServiceId } from '../i18n/utils';
import iot from '../assets/images/iot-lathe.jpg';
import vision from '../assets/images/vision-cameras.jpg';
import rnd from '../assets/images/rnd-pcb-hand.jpg';
import automation from '../assets/images/logistics-shelves.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { labels } = t.solutions;
const images = { iot, vision, rnd, automation } as const;
const tabs = t.solutions.items.map(({ id, tab }) => ({ id, label: tab }));
---

<section id={t.anchors.solutions} class="container-site py-20 md:py-32" aria-labelledby="solutions-title">
  <SectionHeading id="solutions-title" title={t.solutions.title} kicker={t.solutions.kicker} intro={t.solutions.intro} />

  <Tabs id="solutions" label={t.solutions.title} tabs={tabs} class="mt-12 md:mt-16" panelClass="pt-8 md:pt-10">
    {t.solutions.items.map((item, i) => (
      <article slot={`panel-${item.id}`}>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <NotchedImage
            src={images[item.id as keyof typeof images]}
            alt={item.imageAlt}
            corner={i % 2 ? 'br' : 'tl'}
            fill
            class:list={['lg:col-span-7', i % 2 && 'lg:order-last']}
            imgClass="md:h-[30rem]"
          >
            <p class="flex items-center gap-4 pt-1 text-[13px] font-semibold uppercase">
              <span class="size-1.5 bg-accent" aria-hidden="true"></span>
              <span class="font-mono text-accent-ink">0{i + 1}</span>
              {item.tab}
            </p>
          </NotchedImage>

          <div data-reveal class="flex flex-col [--reveal-delay:0.12s] lg:col-span-5">
            <h3 class="text-xl leading-tight md:text-2xl">{item.title}</h3>

            <dl class="mt-8 space-y-6">
              <div>
                <dt class="text-[13px] font-bold uppercase tracking-wide">{labels.problem}</dt>
                <dd class="mt-2 text-[15px] text-graphite">{item.problem}</dd>
              </div>
              <div>
                <dt class="text-[13px] font-bold uppercase tracking-wide">{labels.solution}</dt>
                <dd class="mt-2 text-[15px] text-graphite">{item.solution}</dd>
              </div>
              <div>
                <dt class="flex items-center gap-3 text-[13px] font-bold uppercase tracking-wide">
                  <span class="size-1.5 bg-accent" aria-hidden="true"></span>{labels.benefit}
                </dt>
                <dd class="mt-2 text-[17px] font-semibold leading-snug">{item.benefit}</dd>
              </div>
            </dl>

            <p class="mt-8 font-mono text-xs uppercase tracking-wider text-steel">{labels.outcomes}</p>
            <ol class="mt-3 border-t border-ink">
              {item.outcomes.map((o, n) => (
                <li class="flex items-baseline gap-4 border-b border-line py-3 text-[15px] font-semibold">
                  <span class="font-mono text-xs font-normal text-accent-ink">0{n + 1}</span>{o}
                  {'live' in item && item.live === n && <LiveDot class="ml-auto self-center" />}
                </li>
              ))}
            </ol>

            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5">
              <Button href={sectionHref(lang, 'contact')} variant="link" class="group text-[13px] font-semibold">
                {t.solutions.cta}<span aria-hidden="true" class="inline-block text-accent-ink transition-transform group-hover:translate-x-1">→</span>
              </Button>
              <a href={pages[item.id as ServiceId][lang]} class="group inline-flex items-center gap-2 text-[13px] font-semibold uppercase text-graphite hover:text-ink">
                {t.services.labels.details}<span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
        </div>

      </article>
    ))}
  </Tabs>
</section>
