---
// System diagram for a vertical, on a dark shaped panel (notch top-right holds the caption).
// Input → Processing → Result are drawn as hardware modules with a pin header and a status LED,
// joined by traces. Scrolling through the panel draws the traces and powers the modules up in turn.
// Horizontal from lg up, vertical below. Reduced motion: everything is shown powered on.
import NotchedImage from './ui/NotchedImage.astro';

interface Props {
  title: string;
  labels: readonly [string, string, string];
  stages: readonly { title: string; items: readonly string[] }[];
  class?: string;
}

const { title, labels, stages, class: className } = Astro.props;
---

<NotchedImage corner="tr" slant={28} joint={24} class={className} shapeClass="bg-ink text-paper">
  <p class="flex items-center gap-3 pt-1 text-[13px] font-bold uppercase tracking-wide">
    <span class="size-1.5 bg-accent" aria-hidden="true"></span>{title}
  </p>

  <figure slot="body" class="system px-5 pt-16 pb-8 md:px-10 md:pt-16 md:pb-12 lg:px-12" data-system>
    <figcaption class="hidden font-mono text-[11px] uppercase tracking-wider text-paper/50 md:block">
      {labels.join(' → ')}
    </figcaption>

    <ol class="mt-2 grid items-stretch md:mt-8 lg:grid-cols-[1fr_5rem_1fr_5rem_1fr]">
      {stages.map((stage, i) => (
        <>
          {i > 0 && (
            <li aria-hidden="true" class="trace relative flex h-14 items-center justify-center lg:h-auto" style={`--seg: var(--s${i}, 0)`}>
              <span class="trace-base absolute bg-paper/15"></span>
              <span class="trace-fill absolute bg-accent"></span>
              <span class="via relative z-10 size-3 rounded-full border-2 border-paper/30 bg-ink transition-colors duration-300"></span>
            </li>
          )}
          <li class="module relative rounded-[16px] border border-paper/12 bg-paper/[0.04] px-5 pt-7 pb-6 transition-[border-color,background-color] duration-500 md:px-6" data-module={i}>
            <span aria-hidden="true" class="pins absolute -top-[3px] left-6 flex gap-[5px]">
              {Array.from({ length: 8 }, () => <span class="pin block h-1.5 w-2 rounded-[1px] bg-paper/25 transition-colors duration-500"></span>)}
            </span>
            <span aria-hidden="true" class="led absolute top-5 right-5 size-2 rounded-full bg-paper/20 transition-[background-color,box-shadow] duration-500"></span>

            <p class="flex items-baseline gap-3 font-mono text-[11px] uppercase tracking-wider">
              <span class="text-accent">0{i + 1}</span>
              <span class="text-paper/50">{labels[i]}</span>
            </p>
            <h4 class="mt-3 font-display text-[15px] font-bold uppercase leading-tight">{stage.title}</h4>
            <ul class="mt-4 space-y-2.5 text-sm text-paper/70">
              {stage.items.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-[0.55em] size-1 shrink-0 bg-paper/40" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </li>
        </>
      ))}
    </ol>
  </figure>
</NotchedImage>

<style>
  /* Traces: vertical below lg, horizontal from lg. --seg (0–1) is how much of the trace is drawn. */
  .trace-base,
  .trace-fill {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
  }
  .trace-fill {
    transform-origin: top;
    transform: scaleY(var(--seg));
  }
  @media (min-width: 64rem) {
    .trace-base,
    .trace-fill {
      top: 50%;
      bottom: auto;
      left: -1px;
      right: -1px;
      width: auto;
      height: 2px;
      margin: -1px 0 0;
    }
    .trace-fill {
      transform-origin: left;
      transform: scaleX(var(--seg));
    }
  }

  .module.is-on {
    border-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
    background-color: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }
  .module.is-on .pin {
    background-color: var(--color-accent);
  }
  .module.is-on .led {
    background-color: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }
  .trace.is-on .via {
    border-color: var(--color-accent);
  }
</style>

<script>
  // Scroll-driven power-up. Progress p runs 0 → 1 while the diagram crosses the viewport;
  // module i turns on at its threshold and the trace before it fills over the span leading to it.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  for (const fig of document.querySelectorAll<HTMLElement>('[data-system]')) {
    const modules = [...fig.querySelectorAll<HTMLElement>('[data-module]')];
    const traces = [...fig.querySelectorAll<HTMLElement>('.trace')];
    const on = [0.08, 0.45, 0.82];

    const render = (p: number) => {
      modules.forEach((m, i) => m.classList.toggle('is-on', p >= on[i]));
      traces.forEach((tr, i) => {
        const seg = clamp((p - on[i] - 0.05) / (on[i + 1] - on[i] - 0.1));
        fig.style.setProperty(`--s${i + 1}`, String(seg));
        tr.classList.toggle('is-on', seg >= 1);
      });
    };

    if (reduce) {
      render(1);
      continue;
    }

    let frame = 0;
    const update = () => {
      frame = 0;
      const r = fig.getBoundingClientRect();
      if (!r.height) return;
      const vh = window.innerHeight;
      render(clamp((vh * 0.8 - r.top) / (r.height * 0.9)));
    };
    const schedule = () => (frame ||= requestAnimationFrame(update));

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        window.addEventListener('scroll', schedule, { passive: true });
        schedule();
      } else {
        window.removeEventListener('scroll', schedule);
      }
    }).observe(fig);
    // Panels inside tabs start hidden; recompute when they become visible.
    new ResizeObserver(schedule).observe(fig);
  }
</script>
