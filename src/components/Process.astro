---
// "Cum lucrăm": heading row, then two columns — a tall photo on the left with its notch cut bottom-left,
// and the four steps as a vertical timeline (no cards). Each step's big outlined number fills with orange
// once it scrolls past the middle of the screen; the trace on the left fills along with it.
import SectionHeading from './ui/SectionHeading.astro';
import NotchedImage from './ui/NotchedImage.astro';
import Icon from './ui/Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import bench from '../assets/images/bench-soldering.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const icons = ['audit', 'prototype', 'integrate', 'scale'] as const;
---

<section id={t.anchors.process} class="container-site py-20 md:py-32" aria-labelledby="process-title">
  <SectionHeading id="process-title" title={t.process.title} kicker={t.process.kicker} intro={t.process.intro} />

  <div class="mt-12 grid grid-cols-1 gap-12 md:mt-16 lg:grid-cols-12 lg:gap-16">
    <NotchedImage
      src={bench}
      alt={t.process.imageAlt}
      corner="bl"
      slant={0}
      joint={40}
      class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
      imgClass="md:h-[30rem] lg:h-[40rem] md:object-[30%_50%]"
    >
      <p class="flex items-center gap-4 text-[13px] font-semibold uppercase">
        <span class="size-1.5 bg-accent" aria-hidden="true"></span>{t.process.imageLabel}
      </p>
    </NotchedImage>

    <ol class="steps relative lg:col-span-7" data-steps>
      <span aria-hidden="true" class="absolute top-0 bottom-0 left-[1.5rem] w-0.5 -translate-x-1/2 bg-line md:left-[1.6rem]"></span>
      <span aria-hidden="true" class="steps-fill absolute top-0 left-[1.5rem] w-0.5 -translate-x-1/2 md:left-[1.6rem]"></span>

      {t.process.steps.map((step, i) => (
        <li class="step relative grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 pb-12 last:pb-0 md:grid-cols-[3.2rem_1fr] md:gap-x-8" data-step>
          <span class="num relative z-10 bg-paper py-1 text-center font-display text-[1.6rem] leading-none font-bold md:text-[2.6rem]" aria-hidden="true">
            0{i + 1}
          </span>
          <div class="border-b border-line pb-12 [li:last-child_&]:border-0 [li:last-child_&]:pb-0">
            <div class="flex items-center justify-between gap-3 sm:gap-6">
              <h3 class="min-w-0 text-base leading-tight break-words sm:text-lg md:text-2xl">
                <span class="sr-only">{i + 1}. </span>{step.title}
              </h3>
              <Icon name={icons[i]} class="size-8 md:size-10" />
            </div>
            <p class="mt-4 max-w-lg text-[15px] text-graphite">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .num {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--color-ink);
    transition: color 0.5s, -webkit-text-stroke-color 0.5s;
  }
  .step.is-on .num {
    color: var(--color-accent);
    -webkit-text-stroke-color: var(--color-accent);
  }
  /* The trace is two-tone like the S in the logo: orange first, cyan once the system is live. */
  .steps-fill {
    height: calc(var(--fill, 0) * 100%);
    background: linear-gradient(var(--color-accent) 0 40%, var(--color-brand-cyan-ink) 40%);
  }
</style>

<script>
  // Steps light up as they pass 55% of the viewport; the trace fills down to the last lit step.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const list of document.querySelectorAll<HTMLElement>('[data-steps]')) {
    const steps = [...list.querySelectorAll<HTMLElement>('[data-step]')];

    const update = () => {
      const line = window.innerHeight * 0.55;
      const box = list.getBoundingClientRect();
      steps.forEach((s) => s.classList.toggle('is-on', reduce || s.getBoundingClientRect().top < line));
      const fill = reduce ? 1 : Math.min(1, Math.max(0, (line - box.top) / box.height));
      list.style.setProperty('--fill', String(fill));
    };

    let frame = 0;
    const schedule = () => (frame ||= requestAnimationFrame(() => ((frame = 0), update())));
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
