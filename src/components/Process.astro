---
// "Cum lucrăm", laid out like "HOW DOES IT WORK?" in the reference: heading row, a notched photo
// with a small label in the notch, then the four steps as cut-corner cards joined by a trace.
import SectionHeading from './ui/SectionHeading.astro';
import NotchedImage from './ui/NotchedImage.astro';
import ChamferCard from './ui/ChamferCard.astro';
import Icon from './ui/Icon.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import bench from '../assets/images/bench-soldering.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const icons = ['audit', 'prototype', 'integrate', 'scale'] as const;
---

<section id={t.anchors.process} class="container-site py-20 md:py-32" aria-labelledby="process-title">
  <SectionHeading id="process-title" title={t.process.title} kicker={t.process.kicker} intro={t.process.intro} />

  <NotchedImage src={bench} alt={t.process.imageAlt} class="mt-12 md:mt-16" imgClass="md:h-[28rem] lg:h-[32rem] md:object-[50%_60%]">
    <p class="flex items-center gap-4 pt-1 text-[13px] font-semibold uppercase">
      <span class="size-1.5 bg-accent" aria-hidden="true"></span>{t.process.imageLabel}
    </p>
  </NotchedImage>

  <ol class="relative mt-14 grid gap-8 sm:grid-cols-2 md:mt-16 lg:grid-cols-4 lg:gap-6">
    <span aria-hidden="true" class="absolute top-[3.25rem] right-[12%] left-[12%] hidden h-px bg-line lg:block"></span>
    {t.process.steps.map((step, i) => (
      <ChamferCard as="li" class="bg-paper">
        <Icon name={icons[i]} />
        <p class="mt-8 font-mono text-xs text-accent-ink">0{i + 1}</p>
        <h3 class="mt-1.5 font-sans text-sm font-bold tracking-wide">{step.title}</h3>
        <p class="mt-3 text-sm text-graphite">{step.text}</p>
      </ChamferCard>
    ))}
  </ol>
</section>
