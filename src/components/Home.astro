---
// The single page, rendered once per language by src/pages/index.astro and src/pages/en/index.astro.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Solutions from './Solutions.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Temporary stand-ins so the nav anchors work; each is replaced by its real section in steps 5–8.
const placeholders = [
  { id: t.anchors.process, title: t.process.title },
  { id: t.anchors.whyUs, title: t.whyUs.title },
  { id: t.anchors.contact, title: t.contact.title },
];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} />

  <main>
    <Hero lang={lang} />
    <Solutions lang={lang} />

    {placeholders.map((p) => (
      <section id={p.id} class="container-site min-h-[70vh] border-t border-line py-16">
        <h2 class="text-2xl md:text-4xl">{p.title}</h2>
      </section>
    ))}
  </main>
</Base>
