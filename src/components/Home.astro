---
// The single page, rendered once per language by src/pages/index.astro and src/pages/en/index.astro.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Solutions from './Solutions.astro';
import Process from './Process.astro';
import Cases from './Cases.astro';
import WhyUs from './WhyUs.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import WhatsAppFab from './WhatsAppFab.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Header lang={lang} />

  <main>
    <Hero lang={lang} />
    <Solutions lang={lang} />
    <Process lang={lang} />
    <Cases lang={lang} />
    <WhyUs lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />
  <WhatsAppFab lang={lang} />
</Base>
