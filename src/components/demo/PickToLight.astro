---
// Logistics demo: a 4×3 shelf with a light module on every bin. While on screen, an order plays on a loop:
// each pick location lights up orange with a soft glow and its quantity, the operator presses it (a small
// press-in), it turns cyan with a check, and the order bar and the n/4 counter advance.
// CSS-only keyframes on one shared 8s cycle; paused until the frame is revealed.
import DemoFrame from './DemoFrame.astro';

interface Props {
  demo: { caption: string; order: string; lines: string; shelf: string };
}

const { demo } = Astro.props;
const cols = 4;
const rows = 3;
// Pick sequence: bin index → [step, qty].
const picks = new Map<number, [number, number]>([[5, [0, 2]], [2, [1, 1]], [11, [2, 4]], [8, [3, 3]]]);
const bins = Array.from({ length: cols * rows }, (_, i) => i);

// One shared 8s cycle: step k lights at k·20% (orange + quantity), turns cyan at k·20% + 15%,
// and every light resets together at the end, in sync with the order bar.
const keyframes = [...picks.values()]
  .map(([k]) => {
    const a = k * 20;
    const off = 'background:var(--color-graphite);box-shadow:0 0 0 0 transparent;transform:none';
    const lit = 'background:var(--color-accent);box-shadow:0 0 0 4px rgb(255 115 35 / 0.18),0 6px 18px -4px rgb(255 115 35 / 0.6)';
    const done = 'background:var(--color-brand-cyan-ink);box-shadow:0 0 0 0 transparent;transform:none';
    return `@keyframes ptl-light-${k}{0%,${a}%{${off}}${a + 3}%,${a + 12}%{${lit};transform:none}${a + 13.5}%{${lit};transform:scale(0.92)}${a + 16}%,90%{${done}}96%,100%{${off}}}
@keyframes ptl-qty-${k}{0%,${a}%{opacity:0}${a + 3}%,${a + 13}%{opacity:1}${a + 15}%,100%{opacity:0}}
@keyframes ptl-ok-${k}{0%,${a + 14}%{opacity:0;transform:scale(0.4)}${a + 17}%{opacity:1;transform:scale(1.15)}${a + 19}%,90%{opacity:1;transform:none}96%,100%{opacity:0}}`;
  })
  .join('\n');

// The n/4 counter: number n shows from the moment pick n is confirmed until the next one is.
const doneAt = (n: number) => (n - 1) * 20 + 16;
const counter = Array.from({ length: picks.size + 1 }, (_, n) => {
  const from = n === 0 ? 0 : doneAt(n);
  const to = n === picks.size ? 90 : doneAt(n + 1);
  const show = n === 0 ? `0%,${to - 0.5}%{opacity:1}${to}%,95.5%{opacity:0}96%,100%{opacity:1}` : `0%,${from - 0.5}%{opacity:0}${from}%,${to - 0.5}%{opacity:1}${to}%,100%{opacity:0}`;
  return `@keyframes ptl-n-${n}{${show}}`;
}).join('\n');
---

<style is:inline set:html={`${keyframes}\n${counter}`}></style>

<DemoFrame title={`${demo.order} · ${picks.size} ${demo.lines}`} caption={demo.caption} live>
  <div class="ptl p-5 md:p-7">
    <div class="flex items-center gap-3 font-mono text-[11px] uppercase text-steel">
      <span>{demo.shelf}</span>
      <div class="h-1 flex-1 overflow-hidden rounded-full bg-mist"><div class="progress h-full origin-left rounded-full bg-brand-cyan-ink"></div></div>
      <span class="text-ink tabular-nums"><span class="count">{Array.from({ length: picks.size + 1 }, (_, n) => <span style={`--n:ptl-n-${n}`}>{n}</span>)}</span>/{picks.size}</span>
    </div>

    <ul class="mt-5 grid grid-cols-4 gap-2 border-x-[6px] border-b-[6px] border-graphite/80 bg-mist p-2 md:gap-3 md:p-3">
      {bins.map((i) => {
        const pick = picks.get(i);
        return (
          <li class:list={['bin relative flex aspect-square flex-col justify-end sm:aspect-[4/3] rounded-[4px] border border-line bg-paper', pick && 'is-pick']} style={pick ? `--k:${pick[0]}` : undefined} data-step={pick?.[0]}>
            <span class="absolute top-1 left-1.5 font-mono text-[9px] text-steel sm:top-1.5 sm:left-2 sm:text-[10px]">A-{String(i + 1).padStart(2, '0')}</span>
            <span class="module m-1 flex h-5 items-center sm:m-1.5 sm:h-6 justify-center rounded-[3px] bg-graphite font-mono text-[12px] font-semibold text-paper md:h-7">
              {pick && <><span class="qty">{pick[1]}</span><span class="ok" aria-hidden="true">✓</span></>}
            </span>
          </li>
        );
      })}
    </ul>
  </div>
</DemoFrame>

<style>
  .module {
    position: relative;
  }
  .qty,
  .ok {
    position: absolute;
  }
  /* Static (reduced motion / before reveal): every pick shown done. */
  .is-pick .module {
    background: var(--color-brand-cyan-ink);
  }
  .is-pick .qty {
    opacity: 0;
  }
  .progress {
    transform: scaleX(1);
  }
  /* Counter digits stacked in one cell; the static state shows the last (done) one. */
  .count {
    display: inline-grid;
  }
  .count > span {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .count > span:last-child {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-pick .module,
    .is-pick .qty,
    .is-pick .ok {
      animation-duration: 8s;
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-play-state: paused;
    }
    [data-step='0'] .module { animation-name: ptl-light-0; }
    [data-step='1'] .module { animation-name: ptl-light-1; }
    [data-step='2'] .module { animation-name: ptl-light-2; }
    [data-step='3'] .module { animation-name: ptl-light-3; }
    [data-step='0'] .qty { animation-name: ptl-qty-0; }
    [data-step='1'] .qty { animation-name: ptl-qty-1; }
    [data-step='2'] .qty { animation-name: ptl-qty-2; }
    [data-step='3'] .qty { animation-name: ptl-qty-3; }
    [data-step='0'] .ok { animation-name: ptl-ok-0; }
    [data-step='1'] .ok { animation-name: ptl-ok-1; }
    [data-step='2'] .ok { animation-name: ptl-ok-2; }
    [data-step='3'] .ok { animation-name: ptl-ok-3; }
    .progress {
      transform: scaleX(0);
      animation: progress 8s cubic-bezier(0.22, 1, 0.36, 1) infinite both paused;
    }
    .count > span {
      animation: var(--n) 8s infinite both paused;
    }
    :global(.is-in.is-live) .is-pick .module,
    :global(.is-in.is-live) .is-pick .qty,
    :global(.is-in.is-live) .is-pick .ok,
    :global(.is-in.is-live) .progress,
    :global(.is-in.is-live) .count > span {
      animation-play-state: running;
    }
  }

  @keyframes progress {
    0%, 15% { transform: scaleX(0); }
    18%, 35% { transform: scaleX(0.25); }
    38%, 55% { transform: scaleX(0.5); }
    58%, 75% { transform: scaleX(0.75); }
    78%, 90% { transform: scaleX(1); }
    96%, 100% { transform: scaleX(0); }
  }
</style>
