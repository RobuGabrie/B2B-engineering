---
// Privacy policy, rendered once per language by src/pages/confidentialitate.astro and src/pages/en/privacy.astro.
// Reads like a spec sheet: framed title, numbered sections with mono numbers and hairlines,
// and on large screens a sticky table of contents on the left.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CornerTicks from './ui/CornerTicks.astro';
import Button from './ui/Button.astro';
import { homePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.privacy;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<Base lang={lang} title={p.title} description={p.description} page="privacy">
  <Header lang={lang} page="privacy" />

  <main class="container-site pt-10 pb-24 md:pt-16 md:pb-32">
    <CornerTicks class="max-w-3xl px-3 py-6 md:px-8 md:py-8" offset={0} size={5}>
      <h1 class="text-[clamp(1.1rem,5.3vw,2rem)] leading-[1.05] sm:text-4xl md:text-5xl">{p.title}</h1>
      <p class="mt-4 font-mono text-xs uppercase text-steel">{p.updated}</p>
    </CornerTicks>

    <div class="mt-12 grid grid-cols-1 gap-12 md:mt-16 lg:grid-cols-12">
      <nav aria-label={p.title} class="hidden lg:col-span-4 lg:block">
        <ol class="sticky top-28 border-t border-ink">
          {p.sections.map((s, i) => (
            <li class="border-b border-line">
              <a href={`#s${i + 1}`} class="flex gap-4 py-3 text-sm font-semibold hover:text-accent-ink">
                <span class="font-mono text-xs font-normal text-accent-ink">{num(i)}</span>{s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="lg:col-span-8">
        {p.sections.map((s, i) => (
          <section id={`s${i + 1}`} class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 border-t border-line py-8 first:border-ink first:pt-6 md:grid-cols-[3.5rem_minmax(0,1fr)]">
            <span class="pt-1 font-mono text-xs text-accent-ink">{num(i)}</span>
            <div>
              <h2 class="text-lg leading-tight md:text-xl">{s.title}</h2>
              {s.body.map((para) => <p class="mt-4 max-w-2xl text-[15px] text-graphite">{para}</p>)}
            </div>
          </section>
        ))}

        <div class="mt-4 border-t border-line pt-8">
          <Button href={homePath(lang)} variant="link" class="group text-[13px] font-semibold">
            <span aria-hidden="true" class="inline-block text-accent-ink transition-transform group-hover:-translate-x-1">←</span>{p.back}
          </Button>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} page="privacy" />
</Base>
