---
// Dark footer, the one ink block on the page. Its top edge is a sheet with a rounded top-left corner
// and the cards' 45° cut on the top-right, at full scale. The logo spanning the container, then three columns
// (page links, contact, company details) and a bottom line with ©, language links and back-to-top.
import Logo from './ui/Logo.astro';
import { site } from '../config/site';
import { homePath, languages, sectionHref, useTranslations, type Lang } from '../i18n/utils';
import { mailHref, telHref, whatsappHref } from '../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const codes = Object.keys(languages) as Lang[];
const year = new Date().getFullYear();

const pageLinks = [
  { href: sectionHref(lang, 'home'), label: t.nav.home },
  { href: sectionHref(lang, 'solutions'), label: t.nav.solutions },
  { href: sectionHref(lang, 'process'), label: t.nav.process },
  { href: sectionHref(lang, 'whyUs'), label: t.nav.whyUs },
  { href: sectionHref(lang, 'contact'), label: t.nav.contact },
];
---

<footer class="site-footer bg-ink text-paper">
  <div class="container-site pt-16 pb-8 md:pt-24">
    <Logo onDark class="footer-logo" />
    <p class="mt-6 max-w-md text-[15px] text-paper/70">{t.footer.tagline}</p>

    <div class="mt-14 grid gap-10 border-t border-paper/15 pt-10 sm:grid-cols-2 md:grid-cols-3">
      <nav aria-label={t.footer.navTitle}>
        <h2 class="col-title">{t.footer.navTitle}</h2>
        <ul class="mt-4 grid gap-2 text-[15px]">
          {pageLinks.map((l) => <li><a href={l.href} class="link">{l.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="col-title">{t.footer.contactTitle}</h2>
        <ul class="mt-4 grid gap-2 text-[15px]">
          <li><a href={telHref} class="link">{site.phone}</a></li>
          <li><a href={mailHref} class="link">{site.email}</a></li>
          <li><a href={whatsappHref(lang)} class="link" target="_blank" rel="noopener">{t.contact.whatsapp}</a></li>
        </ul>
      </div>

      <div>
        <h2 class="col-title">{t.footer.companyTitle}</h2>
        <address class="mt-4 text-[15px] leading-relaxed text-paper/70 not-italic">
          {site.legalName}<br />
          {t.footer.cui}: {site.cui}<br />
          {site.address.city}, {t.footer.country}
        </address>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-paper/15 pt-6 text-[13px] text-paper/60 sm:flex-row sm:items-center">
      <p>© {year} {site.name}. {t.footer.rights}</p>
      <div class="flex items-center gap-6 sm:ml-auto">
      <ul class="flex gap-4" aria-label={t.nav.language}>
        {codes.map((code) => (
          <li>
            <a
              href={homePath(code)}
              hreflang={code}
              lang={code}
              aria-current={code === lang ? 'page' : undefined}
              class="link uppercase aria-[current=page]:text-paper aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:underline-offset-4"
            >{code}</a>
          </li>
        ))}
      </ul>
      <a href={sectionHref(lang, 'home')} class="link ml-auto inline-flex items-center gap-2 uppercase">
        {t.footer.backToTop}<span aria-hidden="true" class="text-accent">↑</span>
      </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --cut: 3.5rem;
    border-top-left-radius: 28px;
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
  }
  @media (min-width: 48rem) {
    .site-footer {
      --cut: 6rem;
      border-top-left-radius: 44px;
    }
  }
  /* The logo spans the container width; its height follows from the aspect ratio. */
  .footer-logo :global(svg) {
    width: 100%;
    height: auto;
  }
  .col-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .link {
    color: inherit;
    transition: color 0.15s;
  }
  .link:hover {
    color: var(--color-accent);
  }
</style>
