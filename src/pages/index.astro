---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

// Temporary step-1 page: shows the design tokens. Replaced by real sections in later steps.
const swatches = [
  ['paper', 'bg-paper'],
  ['mist', 'bg-mist'],
  ['line', 'bg-line'],
  ['steel', 'bg-steel'],
  ['graphite', 'bg-graphite'],
  ['ink', 'bg-ink'],
  ['accent', 'bg-accent'],
  ['accent-ink', 'bg-accent-ink'],
];
---

<Base title={`${site.name} — design tokens`}>
  <main class="container-site py-16 md:py-24">
    <p class="font-mono text-sm text-accent-ink">{site.name} / tokens</p>

    <h1 class="mt-6 text-4xl sm:text-5xl md:text-7xl">
      Sisteme inteligente la cheie
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-graphite">
      Proiectăm și dezvoltăm soluții custom pentru industrie, orașe inteligente și produse hardware.
      Diacritice: ă â î ș ț Ă Â Î Ș Ț.
    </p>

    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl">Culori</h2>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {swatches.map(([name, cls]) => (
          <li>
            <div class={`h-20 border border-line ${cls}`} />
            <p class="mt-2 font-mono text-sm">{name}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl md:text-3xl">Tipografie</h2>
      <div class="mt-6 space-y-4">
        <p class="font-display text-3xl font-bold uppercase">Unbounded — display</p>
        <p class="text-xl">Manrope — text de bază pentru paragrafe și interfață.</p>
        <p class="font-mono">IBM Plex Mono — STM32 · ESP32 · 24 V · 4–20 mA</p>
      </div>
    </section>
  </main>
</Base>
