---
// Not-found page. Static hosts serve this file for any unknown URL, so it can't know the visitor's language:
// Romanian first (primary language), English underneath, both linking home.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CornerTicks from '../components/ui/CornerTicks.astro';
import Button from '../components/ui/Button.astro';
import { homePath, useTranslations } from '../i18n/utils';

const ro = useTranslations('ro').notFound;
const en = useTranslations('en').notFound;
---

<Base lang="ro" title={ro.title} description={ro.text} noindex>
  <Header lang="ro" />

  <main class="container-site flex min-h-[70vh] flex-col items-center justify-center py-20 text-center">
    <CornerTicks class="px-8 py-6 md:px-14 md:py-8" offset={0} size={5}>
      <p class="code font-display text-[clamp(5rem,26vw,11rem)] leading-none font-bold" aria-hidden="true">404</p>
    </CornerTicks>
    <h1 class="mt-10 text-2xl md:text-4xl">{ro.title}</h1>
    <p class="mt-3 text-[15px] text-graphite">{ro.text}</p>
    <Button href={homePath('ro')} class="mt-8 min-h-12">{ro.home}</Button>

    <p class="mt-12 border-t border-line pt-6 text-sm text-steel" lang="en">
      {en.title}. <a href={homePath('en')} class="font-semibold text-ink underline decoration-accent underline-offset-4">{en.home}</a>
    </p>
  </main>

  <Footer lang="ro" />
</Base>

<style>
  /* Outlined like the process numbers. */
  .code {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-ink);
  }
</style>
